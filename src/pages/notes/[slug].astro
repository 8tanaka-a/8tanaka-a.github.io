---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DotGrid from '../../components/DotGrid.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { dotPatterns } from '../../data/dot-patterns';

export const getStaticPaths = (async () => {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, index: i },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { note, index } = Astro.props as Props;
const { Content } = await render(note);

const number = String(index + 1).padStart(2, '0');
const dateStr = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit' })
  .format(note.data.date)
  .replace('-', '.');

const pattern = dotPatterns[note.data.dotPattern] ?? {
  highlightedCells: [],
  animationSequence: [],
};

const breadcrumbs = [
  { label: 'Top', href: '/' },
  { label: 'Notes', href: '/notes' },
  { label: number },
];
---

<BaseLayout
  title={`${note.data.title} | one code`}
  description={note.data.description ?? `${note.data.title} - one code の記事。`}
>
  <main id="main" class="notes-main">
    <div class="dot-grid-area">
      <DotGrid
        highlightedCells={pattern.highlightedCells}
        animationSequence={pattern.animationSequence}
        accentColor="--color-accent-green"
        staggerInterval={pattern.staggerInterval}
      />
    </div>

    <div class="note-head">
      <h2 class="note-heading">
        <span class="note-number">{number}</span>
        <span class="note-title">{note.data.title}</span>
      </h2>

      <p class="note-date">{dateStr}</p>
    </div>

    <div class="note-body-wrap">
      <div class="note-body">
        <Content />
      </div>
    </div>

    <div class="breadcrumb-area">
      <Breadcrumb items={breadcrumbs} accentColor="--color-accent-green" />
    </div>
  </main>
</BaseLayout>

<style>
  /*
    PC レイアウトでは GSAP enter が opacity:0 → 1 でフェードインさせるため、
    新ページ描画時に一瞬 opacity:1 でフラッシュしないよう CSS で初期非表示にする。
  */
  @media (min-width: 1200px) {
    .note-heading,
    .note-date,
    .note-body,
    .breadcrumb-area {
      opacity: 0;
    }
  }

  .notes-main {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: repeat(10, 1fr);
    gap: 0.75rem;
    padding-bottom: 2rem;
  }

  .dot-grid-area {
    grid-column: 1 / 5;
    grid-row: 1 / -1;
    align-self: end;
  }

  .note-head {
    grid-column: 6 / 11;
    grid-row: 2 / 4;
  }

  .note-body-wrap {
    grid-column: 6 / 11;
    grid-row: 4 / 9;
  }

  .note-heading {
    display: flex;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
  }

  .note-number {
    font-family: var(--font-mono);
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    margin: 0.5rem 0 0;
  }

  .note-body {
    margin: 0;
  }

  .note-body :global(p) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    letter-spacing: 0.08em;
    white-space: pre-line;
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  .note-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .breadcrumb-area {
    grid-column: 9 / 11;
    grid-row: 10;
    align-self: end;
    justify-self: end;
  }

  @media (max-width: 1199px) {
    .notes-main {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding-bottom: 1rem;
    }

    .note-head {
      order: 1;
    }

    .note-heading {
      font-size: 1.5rem; /* 24px */
    }

    .dot-grid-area {
      order: 2;
      align-self: end;
      width: 50vw;
      margin-bottom: 2.5rem;
    }

    .note-body-wrap {
      order: 3;
    }

    .breadcrumb-area {
      order: 4;
      align-self: end;
      margin-top: 2rem;
    }
  }

  /*
    SP では Markdown 内の単一改行 (pre-line で <br> 化) が
    狭幅の自動折返しと衝突して句点で人為改行が出てしまうため、
    通常の white-space に戻して自動折返しに任せる。
    段落区切り (\n\n) は別 <p> になるので影響なし。
  */
  @media (max-width: 767px) {
    .note-body :global(p) {
      white-space: normal;
    }
  }
</style>

<script>
  import { setupPageMotion } from '../../scripts/page-motion';

  setupPageMotion({
    main: '.notes-main',
    targets: ['.note-heading', '.note-date', '.note-body', '.breadcrumb-area'],
    enter: { duration: 0.25, stagger: 0.05, delay: 0.1 },
  });
</script>
