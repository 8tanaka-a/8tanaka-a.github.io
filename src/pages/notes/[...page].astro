---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DotGrid from '../../components/DotGrid.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { dotPatterns } from '../../data/dot-patterns';

export const getStaticPaths = (async ({ paginate }) => {
  const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return paginate(notes, { pageSize: 5 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props as Props;

const sigmaPattern = dotPatterns.notes1;

const breadcrumbs = [{ label: 'Top', href: '/' }, { label: 'Notes' }];
---

<BaseLayout
  title="Notes | one code"
  description="技術や開発に関する考えを綴った one code の記事一覧。"
>
  <main id="main" class="notes-list-main">
    <div class="dot-grid-area">
      <DotGrid
        highlightedCells={sigmaPattern.highlightedCells}
        animationSequence={sigmaPattern.animationSequence}
        accentColor="--color-accent-green"
        staggerInterval={sigmaPattern.staggerInterval}
      />
    </div>

    <h2 class="notes-page-title">Notes</h2>

    <div class="notes-list-area">
      <ul class="notes-list">
        {
          page.data.map((note) => {
            const dateStr = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit' })
              .format(note.data.date)
              .replace('-', '.');
            return (
              <li>
                <a href={`/notes/${note.id}`} class="note-card">
                  <span class="note-date">{dateStr}</span>
                  <span class="note-title">{note.data.title}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      {
        page.lastPage > 1 && (
          <nav class="pagination" aria-label="Notes ページ送り">
            {page.url.prev ? (
              <a class="page-link" href={page.url.prev} rel="prev">
                <span aria-hidden="true">←</span> Prev
              </a>
            ) : (
              <span class="page-link is-disabled" aria-disabled="true">
                <span aria-hidden="true">←</span> Prev
              </span>
            )}
            <span class="page-status">
              {page.currentPage} / {page.lastPage}
            </span>
            {page.url.next ? (
              <a class="page-link" href={page.url.next} rel="next">
                Next <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="page-link is-disabled" aria-disabled="true">
                Next <span aria-hidden="true">→</span>
              </span>
            )}
          </nav>
        )
      }
    </div>

    <div class="breadcrumb-area">
      <Breadcrumb items={breadcrumbs} accentColor="--color-accent-green" />
    </div>
  </main>
</BaseLayout>

<style>
  /*
    PC レイアウトでは GSAP enter が opacity:0 → 1 でフェードインさせるため、
    新ページ描画時に一瞬 opacity:1 でフラッシュしないよう CSS で初期非表示にする。
  */
  @media (min-width: 1200px) {
    .notes-page-title,
    .note-card,
    .pagination,
    .breadcrumb-area {
      opacity: 0;
    }
  }

  .notes-list-main {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: minmax(0, 1fr) auto auto minmax(0, 2fr) auto;
    gap: 0.75rem;
    padding-bottom: 2rem;
  }

  .dot-grid-area {
    grid-column: 1 / 5;
    grid-row: 1 / -1;
    align-self: end;
  }

  .notes-page-title {
    grid-column: 6 / 8;
    grid-row: 2;
    font-family: var(--font-geo);
    font-size: 2.25rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-text);
    margin: 0;
    align-self: start;
  }

  .notes-list-area {
    grid-column: 6 / 11;
    grid-row: 3;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .note-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    background-color: var(--color-dot);
    color: var(--color-text);
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  @media (hover: hover) {
    .note-card:hover {
      background-color: var(--color-accent-green);
      color: var(--color-bg);
    }
  }

  .note-card:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .note-title {
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    transition: color 0.3s;
  }

  @media (hover: hover) {
    .page-link:not(.is-disabled):hover {
      color: var(--color-accent-green);
    }
  }

  .page-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .page-link.is-disabled {
    opacity: 0.35;
    cursor: default;
  }

  .page-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text);
  }

  .breadcrumb-area {
    grid-column: 9 / 11;
    grid-row: 5;
    align-self: end;
    justify-self: end;
  }

  @media (max-width: 1199px) {
    .notes-list-main {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding-bottom: 1rem;
    }

    .notes-page-title {
      order: 1;
      font-size: 1.5rem; /* 24px */
    }

    .dot-grid-area {
      order: 2;
      align-self: end;
      width: 50vw;
      margin-bottom: 2.5rem;
    }

    .notes-list-area {
      order: 3;
    }

    .breadcrumb-area {
      order: 4;
      align-self: end;
      margin-top: 2rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const isStacked = () => window.matchMedia('(max-width: 1199px)').matches;

  function enterAnimation() {
    if (isStacked()) return;
    if (!document.querySelector('.notes-list-main')) return;
    const elements = [
      document.querySelector('.notes-page-title'),
      ...Array.from(document.querySelectorAll('.note-card')),
      document.querySelector('.pagination'),
      document.querySelector('.breadcrumb-area'),
    ].filter((el) => el !== null);
    if (elements.length === 0) return;

    // メニュー経由の遷移ではメニューのフェードアウトが視覚的な遷移なので
    // GSAP のフェードインはスキップ。ただし CSS pre-hide で opacity:0 のままだと
    // メニュー消失後に見えないので opacity:1 を直接当てて可視化する。
    if ((window as Window & { __menuNavigating?: boolean }).__menuNavigating) {
      gsap.set(elements, { opacity: 1, y: 0 });
      return;
    }

    gsap.set(elements, { opacity: 0, y: 16 });
    gsap.to(elements, {
      opacity: 1,
      y: 0,
      duration: 0.3,
      stagger: 0.05,
      ease: 'power2.out',
      delay: 0.1,
    });
  }

  function setupExitAnimation() {
    document.addEventListener('astro:before-preparation', (e) => {
      if ((window as Window & { __menuNavigating?: boolean }).__menuNavigating) return;
      if (isStacked()) return;
      const main = document.querySelector('.notes-list-main');
      if (!main || !('loader' in e)) return;

      const elements = [
        main.querySelector('.breadcrumb-area'),
        main.querySelector('.pagination'),
        ...Array.from(main.querySelectorAll('.note-card')).reverse(),
        main.querySelector('.notes-page-title'),
      ].filter((el) => el !== null);

      if (elements.length === 0) return;

      const event = e as Event & { loader: () => Promise<void> };
      const originalLoader = event.loader;
      event.loader = async () => {
        await Promise.all([
          originalLoader(),
          new Promise<void>((resolve) => {
            gsap.to(elements, {
              opacity: 0,
              y: 10,
              duration: 0.2,
              stagger: 0.02,
              ease: 'power2.in',
              onComplete: resolve,
            });
          }),
        ]);
      };
    });
  }

  setupExitAnimation();
  document.addEventListener('astro:page-load', enterAnimation);
</script>
