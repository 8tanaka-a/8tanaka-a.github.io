---
import BaseLayout from '../layouts/BaseLayout.astro';
import DotGrid from '../components/DotGrid.astro';
import { dotPatterns } from '../data/dot-patterns';

const pattern = dotPatterns.exclamation;
---

<BaseLayout title="404 | one code" description="お探しのページは見つかりませんでした。">
  <main id="main" class="not-found-main">
    <div class="dot-grid-area">
      <DotGrid
        highlightedCells={pattern.highlightedCells}
        animationSequence={pattern.animationSequence}
        staggerInterval={pattern.staggerInterval}
      />
    </div>

    <div class="head">
      <h2 class="number">404</h2>
      <p class="message">お探しのページは見つかりませんでした。</p>
    </div>

    <div class="back-area">
      <a href="/" class="back-link">
        ← Top に戻る
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  /*
    PC レイアウトでは GSAP enter が opacity:0 → 1 でフェードインさせるため、
    新ページ描画時に一瞬 opacity:1 でフラッシュしないよう CSS で初期非表示にする。
  */
  @media (min-width: 1200px) {
    .number,
    .message,
    .back-area {
      opacity: 0;
    }
  }

  .not-found-main {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: repeat(10, 1fr);
    gap: 0.75rem;
    padding-bottom: 2rem;
  }

  .dot-grid-area {
    grid-column: 1 / 5;
    grid-row: 1 / -1;
    align-self: end;
  }

  .head {
    grid-column: 6 / 11;
    grid-row: 2 / 4;
  }

  .number {
    font-family: var(--font-mono);
    font-size: 2.25rem; /* 36px */
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
  }

  .message {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin: 1rem 0 0;
  }

  .back-area {
    grid-column: 9 / 11;
    grid-row: 10;
    align-self: end;
    justify-self: end;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    transition: opacity 0.2s;
  }

  @media (hover: hover) {
    .back-link:hover {
      opacity: 0.7;
    }
  }

  .back-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  @media (max-width: 1199px) {
    .not-found-main {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding-bottom: 1rem;
    }

    .head {
      order: 1;
    }

    .number {
      font-size: 1.5rem; /* 24px */
    }

    .dot-grid-area {
      order: 2;
      align-self: end;
      width: 50vw;
      margin-bottom: 2.5rem;
    }

    .back-area {
      order: 3;
      align-self: end;
      margin-top: 2rem;
    }
  }
</style>

<script>
  import { setupPageMotion } from '../scripts/page-motion';

  setupPageMotion({
    main: '.not-found-main',
    targets: ['.number', '.message', '.back-area'],
    enter: { duration: 0.4, stagger: 0.08, delay: 0.15 },
  });
</script>
